cat > .gitignore << 'EOF'
# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
backend/venv/
*.egg-info/
.pytest_cache/

# Jupyter
.ipynb_checkpoints
*.ipynb_checkpoints

# Data
ml/data/raw/*
ml/data/processed/*
!ml/data/raw/.gitkeep
!ml/data/processed/.gitkeep

# Models
ml/models/*.pkl
ml/models/*.cbm
ml/models/*.joblib

# MLflow
ml/experiments/
mlruns/

# Logs
logs/*.log
*.log

# Environment
.env
.env.local

# Node
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.pnpm-store/

# Docker
*.tar.gz

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Reports (opcional - puedes querer versionar algunos)
reports/figures/*.png
reports/figures/*.jpg
EOF