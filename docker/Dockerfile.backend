# ==========================================
# MULTI-STAGE BUILD - Backend API
# Optimizado para producción con soporte para desarrollo
# ==========================================

# ==========================================
# Stage 1: Builder - Compilar dependencias
# ==========================================
FROM python:3.12-slim AS builder

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Instalar dependencias de compilación
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Copiar requirements de producción para optimizar imagen
COPY backend/requirements-prod.txt ./requirements.txt

# Instalar dependencias en directorio local del usuario
RUN pip install --user --no-warn-script-location -r requirements.txt

# ==========================================
# Stage 2: Runtime - Imagen final ligera
# ==========================================
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH=/home/appuser/.local/bin:$PATH

# Instalar solo dependencias runtime necesarias + curl para healthcheck
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    postgresql-client \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Crear usuario no-root
RUN useradd -m -u 1000 appuser

# Crear directorios necesarios
WORKDIR /app
RUN mkdir -p /app/logs /app/ml_models && \
    chown -R appuser:appuser /app

# Copiar dependencias Python desde builder
COPY --from=builder --chown=appuser:appuser /root/.local /home/appuser/.local

# Copiar código de aplicación (SELECTIVO - no todo)
# IMPORTANTE: Ajusta estas rutas según tu estructura
COPY --chown=appuser:appuser backend/app /app/app
COPY --chown=appuser:appuser ml/models /app/ml_models

# Cambiar a usuario no-root
USER appuser

# Healthcheck usando curl (más ligero que requests)
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8000/api/v1/health || exit 1

# Exponer puerto
EXPOSE 8000

# Comando por defecto (PRODUCCIÓN - sin --reload)
# Para desarrollo, sobreescribe con docker-compose
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]