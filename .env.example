# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=predictor_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/predictor_db

# Redis Configuration
REDIS_PASSWORD=redis123
REDIS_URL=redis://default:redis123@localhost:6379/0

# Backend Configuration
SECRET_KEY=your-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ENVIRONMENT=development

# MLflow Configuration
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=dropout-prediction

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=Predictor de Deserción Escolar

# pgAdmin Configuration (Optional)
PGADMIN_EMAIL=admin@predictor.com
PGADMIN_PASSWORD=admin

# API Keys (Add your keys here if needed)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Monitoring (for production)
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# CORS Settings
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
